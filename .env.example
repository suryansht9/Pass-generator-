# Database Connection (SQLite locally, PostgreSQL for Supabase)
DATABASE_URL="file:./dev.db"
# For Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Application Base URL (Used for QR Code Generation)
# For local network testing: http://192.168.1.X:3000
# For production: https://your-hackathon-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Dashboard Password
ADMIN_PASSWORD="adminpass123"

# JWT Secret for Session Cookies
JWT_SECRET="cfc-hackathon-super-secret-key-2026"

# Toggle whether access code is required for registration ("true" or "false")
REQUIRE_ACCESS_CODE="true"
